<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrar Medicamento"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- Nombre del Medicamento -->
    <EditText
        android:id="@+id/etNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del medicamento (ej. Paracetamol)"
        android:inputType="textPersonName"
        android:layout_marginBottom="12dp" />

    <!-- Dosis -->
    <EditText
        android:id="@+id/etDosis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Dosis (ej. 500mg)"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <!-- Presentación -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Presentación:"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spPresentacion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:entries="@array/presentaciones_array"
        android:layout_marginBottom="12dp" />

    <!-- Campo Interactivo de Fecha de Inicio -->
    <EditText
        android:id="@+id/etFechaInicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Toca para seleccionar Fecha de Inicio"
        android:focusable="false"
        android:clickable="true"
        android:layout_marginBottom="12dp" />

    <!-- Campo Interactivo de Hora de Toma -->
    <EditText
        android:id="@+id/etHoraToma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Toca para seleccionar Hora de Toma"
        android:focusable="false"
        android:clickable="true"
        android:layout_marginBottom="20dp" />

    <!-- Botón Guardar -->
    <Button
        android:id="@+id/btnGuardar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Medicamento" />

</LinearLayout>
