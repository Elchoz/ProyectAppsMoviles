<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHistorialNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del medicamento"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistorialDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dosis • Presentación"
                android:textSize="14sp"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/tvHistorialHorario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hora: 08:00 | Fecha: 01/05/2026"
                android:textSize="13sp"
                android:textColor="#777777" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEliminarMedicamento"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Eliminar medicamento" />

    </LinearLayout>

</androidx.cardview.widget.CardView>